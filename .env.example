# URL publique du projet Supabase, sans clé secrète.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anon/publishable uniquement — jamais service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplacer-par-la-cle-publique

# URL publique du site, pour les métadonnées (URL canonique, Open Graph).
# Facultatif : en hébergement Vercel, VERCEL_PROJECT_PRODUCTION_URL est
# utilisée automatiquement. À renseigner pour un domaine personnalisé.
# NEXT_PUBLIC_SITE_URL=https://ecole.exemple.org
