# URL publique du projet Supabase, sans clé secrète.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anon/publishable uniquement — jamais service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplacer-par-la-cle-publique

# URL publique du site, pour les métadonnées (URL canonique, Open Graph).
# Facultatif : en hébergement Vercel, VERCEL_PROJECT_PRODUCTION_URL est
# utilisée automatiquement. À renseigner pour un domaine personnalisé.
# NEXT_PUBLIC_SITE_URL=https://ecole.exemple.org

# Prévisualisation reliée à un Supabase local — facultatif.
# Le navigateur joint l’application par son origine publique : les appels
# /auth/v1 et /rest/v1 sont alors réécrits vers le Supabase local.
# SUPABASE_LOCAL_PROXY_TARGET=http://127.0.0.1:54321

# Hôte joint par le code serveur, lorsque le navigateur passe par un relais.
# Sans cette variable, le serveur utilise NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321
